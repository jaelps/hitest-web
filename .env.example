# Configure these variables in Vercel Project Settings > Environment Variables.
# Link an Upstash Redis database through the Vercel Marketplace integration.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-a-secret-redis-token
# Generate a random token with at least 32 characters; never expose this value in frontend code.
HITEST_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
